generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth ────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole   @default(CLIENT)
  phone         String?
  company       String?
  accounts      Account[]
  sessions      Session[]
  briefings     Briefing[]
  comments      ProposalComment[]
  orders        Order[]
  orderMessages OrderMessage[]
}

enum UserRole {
  CLIENT
  ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domínio DevFlow ─────────────────────────────────────────────────────────

model Briefing {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectType    String
  painPoints     String   @db.Text
  targetAudience String
  features       String[] // array de strings no PostgreSQL
  customFeatures String?
  budget         String
  timeline       String
  complexityScore  Int?
  hoursMin         Int?
  hoursMax         Int?
  status           BriefingStatus @default(RECEIVED)
  scope            Scope?
  proposal         Proposal?
  referenceProject ReferenceProject?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum BriefingStatus {
  RECEIVED
  IN_ANALYSIS
  PROPOSAL_SENT
  IN_NEGOTIATION
  APPROVED
  IN_PROGRESS
  DELIVERED
}

// ─── M2: Escopo Técnico ──────────────────────────────────────────────────────

/// Escopo técnico gerado pelo Cérebro de Arquitetura (M2).
model Scope {
  id               String   @id @default(cuid())
  briefingId       String   @unique
  briefing         Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  features         Json     // ScopeFeature[]
  userStories      Json     // UserStory[]
  screens          Json     // string[]
  integrations     Json     // string[]
  techRecommended  Json     // string[]
  hoursEstimate    Int
  costMin          Float
  costMax          Float
  confidence       Int      // 0-100
  generatedBy      String   @default("gemini-flash-latest")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── S6: Similar Projects Library ────────────────────────────────────────────

// ─── M3: Deal Room ───────────────────────────────────────────────────────────

/// Proposta comercial gerada a partir do escopo M2.
model Proposal {
  id          String            @id @default(cuid())
  briefingId  String            @unique
  briefing    Briefing          @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  version     Int               @default(1)
  status      ProposalStatus    @default(DRAFT)
  /// Conteúdo HTML/Markdown da proposta gerada pela IA
  content     String            @db.Text
  /// Sumário executivo (texto curto para preview)
  summary     String            @db.Text
  /// Total de horas e custo (copiados do Scope para histórico)
  hoursTotal  Int
  costMin     Float
  costMax     Float
  /// Comentário do cliente ao solicitar alterações
  clientNote  String?           @db.Text
  /// Quando foi aprovado/rejeitado
  reviewedAt  DateTime?
  comments    ProposalComment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// Comentário inline do cliente numa proposta (por parágrafo/cláusula).
model ProposalComment {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Trecho de texto citado para contexto
  excerpt    String   @db.Text
  body       String   @db.Text
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum ProposalStatus {
  DRAFT          // rascunho (gerado pela IA, admin ainda não enviou)
  SENT           // enviada ao cliente (status briefing → PROPOSAL_SENT)
  REVISION       // cliente pediu alterações
  APPROVED       // cliente aprovou (status briefing → APPROVED)
  REJECTED       // cliente rejeitou
}

// ─── M4: Portal de Pedidos ──────────────────────────────────────────────────

/// Pedido submetido por um cliente existente.
model Order {
  id              String      @id @default(cuid())
  clientId        String
  client          User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type            String      // "new_feature" | "bug_fix" | "new_project" | "support" | "other"
  description     String      @db.Text
  urgency         String      @default("normal") // "low" | "normal" | "high" | "critical"
  attachments     String[]    // URLs dos ficheiros enviados
  status          OrderStatus @default(PENDING)
  /// Resposta do admin
  productionInfo  String?     @db.Text
  estimatedValue  Float?
  adminNote       String?     @db.Text
  respondedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  messages        OrderMessage[]
}

enum OrderStatus {
  DRAFT            // rascunho (ainda não submetido)
  PENDING          // aguardando avaliação do admin
  EVALUATING       // admin a avaliar
  PROPOSAL_SENT    // proposta de produção + valor enviada ao cliente
  APPROVED         // cliente aprovou
  REVISION         // cliente pediu revisão
  REJECTED         // cliente recusou
  IN_PRODUCTION    // em execução
  COMPLETED        // concluído
}

/// Projeto de referência vetorizado para busca por similaridade.
/// O embedding é armazenado como JSON (array de 768 floats).
/// A busca por similaridade (cosine) é calculada na aplicação.
model ReferenceProject {
  id              String    @id @default(cuid())
  title           String
  description     String    @db.Text
  projectType     String
  features        String[]
  techStack       String[]
  complexityScore Int
  hoursActual     Int
  budgetRange     String
  briefingId      String?   @unique
  briefing        Briefing? @relation(fields: [briefingId], references: [id])
  embedding       String    @db.Text // JSON array de 768 floats
  createdAt       DateTime  @default(now())
}

// ─── M6: Canal de Mensagens nos Pedidos ─────────────────────────────────────

/// Mensagem numa thread de pedido (client ↔ admin).
model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
}
