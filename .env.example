# ─────────────────────────────────────────────────────────────────────────────
#  quantum-technology-agency — variáveis de ambiente
#  Copie este ficheiro para .env.local e preencha os valores reais.
#  NUNCA faça commit do .env.local — já está no .gitignore.
#
#  GitHub Secrets necessários (Settings → Secrets → Actions):
#    DATABASE_URL, AUTH_SECRET, AUTH_URL
#    EMAIL_SERVER_HOST, EMAIL_SERVER_PORT, EMAIL_SERVER_USER
#    EMAIL_SERVER_PASSWORD, EMAIL_FROM, EMAIL_ADMIN, ADMIN_EMAIL
#    STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
#    GEMINI_API_KEY, N8N_WEBHOOK_URL
#    EC2_HOST, EC2_SSH_KEY
# ─────────────────────────────────────────────────────────────────────────────

# ─── Banco de dados ───────────────────────────────────────────────────────────
# PostgreSQL (Supabase, Neon, Railway, ou servidor próprio)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/quantum_devflow

# ─── NextAuth v5 ──────────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 32  (ou PowerShell: [Convert]::ToBase64String((New-Object byte[] 32 | %{ $rng.GetBytes($_); $_ })))
AUTH_SECRET=GERAR_COM_OPENSSL_RAND
# URL pública da aplicação (sem barra final)
AUTH_URL=https://seudominio.com

# ─── SMTP (Gmail ou outro provider) ──────────────────────────────────────────
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=seuemail@gmail.com
# Gmail: criar "Palavra-passe de app" em myaccount.google.com/apppasswords
EMAIL_SERVER_PASSWORD=PALAVRA_PASSE_DE_APP
EMAIL_FROM=Quantum Technology <seuemail@gmail.com>
EMAIL_ADMIN=admin@seudominio.com
ADMIN_EMAIL=admin@seudominio.com

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Obter em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Chave secreta: https://dashboard.stripe.com/apikeys
# Produção: sk_live_...   |   Teste: sk_test_...
STRIPE_SECRET_KEY=sk_live_...
# Segredo do webhook: criar endpoint em https://dashboard.stripe.com/webhooks
# Evento obrigatório: checkout.session.completed
# URL do endpoint: https://seudominio.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Usar mock do Stripe em desenvolvimento local (true) ou produção (false)
STRIPE_MOCK=true

# ─── n8n (opcional — captura de leads) ───────────────────────────────────────
# Deixar vazio para desativar a integração
N8N_WEBHOOK_URL=https://SEU_N8N/webhook/lead-capture
